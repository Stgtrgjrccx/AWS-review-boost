# =============================================
# ReviewBoost Pro — Environment Variables
# Copy this file to .env and fill in your values
# =============================================

# Database (PostgreSQL on Render)
DATABASE_URL="postgresql://user:password@host:5432/reviewboost?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-super-secret-key-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (for business owner login)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Twilio (SMS + WhatsApp)
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
TWILIO_SMS_FROM="+1xxxxxxxxxx"

# Google Gemini AI (for personalized messages + funnel design selection)
GEMINI_API_KEY="your-gemini-api-key"

# Cloudinary (logo uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# App
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
